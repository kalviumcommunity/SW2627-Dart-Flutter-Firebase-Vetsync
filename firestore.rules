rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is an authenticated veterinary staff member
    function isAuthenticated() {
      return request.auth != null;
    }

    // Vets collection: Vets can read all profiles, but write only their own profile
    match /vets/{vetId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == vetId;
    }

    // Pets collection: Authenticated vets can read, create, and update pet records
    match /pets/{petId} {
      allow read, write: if isAuthenticated();
    }

    // Visits collection: Authenticated vets can read all cross-branch visits and create new visits
    match /visits/{visitId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.vetId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.vetId == request.auth.uid;
    }

    // Branches collection: Read-only for authenticated vets
    match /branches/{branchId} {
      allow read: if isAuthenticated();
      allow write: if false; // Managed by system administrators
    }
  }
}
